# ============================================================
#  ACADEMIA ERP - ENVIRONMENT CONFIGURATION TEMPLATE
#  Copy this file to .env and fill in your credentials
# ============================================================

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/academia_erp?retryWrites=true&w=majority

# JWT secret (min 32 characters random string)
JWT_SECRET=your_jwt_secret_here

# JWT Token expiry
JWT_EXPIRES_IN=7d

# Server Config
PORT=5000
NODE_ENV=development

# Allowed CORS origins
FRONTEND_URL=http://localhost:5000

# Default Admin Seed Credentials
ADMIN_EMAIL=admin@academia.edu
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=System Administrator

# Background Jobs / Process Manager / Scheduler Settings
JOB_PROCESSING_ENABLED=true
JOB_WORKERS=2
JOB_QUEUE_MAX=50
JOB_MAX_ATTEMPTS=3
JOB_TIMEOUT_MS=120000
JOB_POLICY=fcfs
JOB_SJF_AGING_MS=60000
JOB_SHUTDOWN_GRACE_MS=10000
JOB_MIN_PROCESSING_MS=0

